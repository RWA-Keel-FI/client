# Copy to .env (gitignored) and restart `pnpm dev`.

# WalletConnect / Reown project id (free, 32 hex chars): https://dashboard.reown.com
# Without it the WalletConnect option is disabled and the UI says so; injected wallets (MetaMask etc.) still work.
VITE_WALLETCONNECT_PROJECT_ID=

# Optional: override the Arc Testnet RPC (default https://rpc.testnet.arc.network).
# For a local anvil fork of Arc Testnet use http://127.0.0.1:8546 (same chain id 5042002).
# VITE_ARC_RPC_URL=

# Optional: which deployments/<name>.json to read (default arc-testnet; arc-fork for a local fork).
# VITE_DEPLOYMENT=arc-testnet

# Optional tuning: poll interval in ms (min 5000), blocks of event history to load, getLogs chunk size.
# VITE_POLL_MS=6000
# VITE_LOGS_LOOKBACK=20000
# VITE_LOG_CHUNK=9000
